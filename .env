# Multiple Groq API Keys for Automatic Rotation
# ⚠️ ADD YOUR GROQ API KEYS HERE (from https://console.groq.com/keys)
# Format: gsk_xxxxx,gsk_yyyyy,gsk_zzzzz (comma-separated)
GROQ_API_KEYS=your_groq_api_keys_here

# Use a valid Groq model - openai/gpt-oss-20b is the fastest (1000 T/sec) and currently available
# Alternative: openai/gpt-oss-120b (500 T/sec, more capable but slower)
GROQ_MODEL=openai/gpt-oss-20b

GROQ_WHISPER_MODEL=whisper-large-v3-turbo
PORT=3001
ADMIN_PASSWORD=admin123
CAMB_API_KEY=85f8a274-53db-42cd-9ef9-8c3ebfac81c0
CAMB_VOICE_ID=197305
CAMB_LANGUAGE=en-us
CAMB_MODEL=mars-8.1-flash-beta

# Text-to-Speech Configuration
# Using FREE Microsoft Edge TTS (Browser Web Speech API)
# No API key required - uses browser's built-in high-quality voices
# Best experience in Microsoft Edge browser
TTS_PROVIDER=edge

# ElevenLabs TTS (Optional - Not currently used)
# ELEVENLABS_API_KEY=sk_e7fdcc1b52c71a9e92414112af6f3de7a8308fd02185c77d
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
